{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="categories" data-scene="4">
  <div class="purelane-wrap">

    <div class="purelane-panel-head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="purelane-d2" style="margin-top: 12px;">{{ section.settings.heading | default: 'Find the right bundle for you' }}</h2>
    </div>

    <div class="purelane-cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a class="purelane-glass purelane-cat purelane-rv purelane-rv-d{{ forloop.index }}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
            <span class="purelane-ph">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 260 }}" alt="{{ block.settings.title | escape }}" class="purelane-pimg" loading="lazy">
              {%- else -%}
                {% render 'purelane-icons', icon: 'bottle-fallback' %}
              {%- endif -%}
            </span>
            <span class="purelane-txt">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.subtitle }}</p>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "purelane-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category_card", "settings": { "title": "Kitchen bundle", "subtitle": "Grease, dishes & more" } },
        { "type": "category_card", "settings": { "title": "Bathroom bundle", "subtitle": "Deep clean & disinfect" } },
        { "type": "category_card", "settings": { "title": "Laundry bundle", "subtitle": "Softer, fresher wash" } },
        { "type": "category_card", "settings": { "title": "Hard water bundle", "subtitle": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}
