{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="shop" data-scene="3">
  <div class="purelane-wrap">

    <div class="purelane-panel-head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      <h2 class="purelane-d2">{{ section.settings.heading | default: 'Loved by 30,000 homes' }}</h2>

      <div class="purelane-rule">
        <i></i>
        {% render 'purelane-icons', icon: 'leaf-shield' %}
        <i></i>
      </div>
    </div>

    <div class="purelane-shelf">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- assign products_to_show = section.settings.products_to_show | default: 8 -%}

      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign badge = ''
            if forloop.index == 1
              assign badge = 'Best seller'
            elsif forloop.index == 2
              assign badge = 'Best seller'
            elsif forloop.index == 3
              assign badge = 'Top rated'
            elsif forloop.index == 4
              assign badge = 'New'
            endif
          -%}
          {% render 'purelane-card-product', card_product: product, custom_badge: badge, lazy_load: forloop.index > 4 %}
        {%- endfor -%}
      {%- else -%}
        <!-- Theme preview fallback if no collection selected yet -->
        {%- for i in (1..products_to_show) -%}
          <article class="purelane-glass-2 purelane-card purelane-rv">
            <div class="purelane-shot">
              <span class="purelane-pill">{% cycle 'Best seller', 'Best seller', 'Top rated', 'New' %}</span>
              {% render 'purelane-icons', icon: 'bottle-fallback' %}
            </div>
            <h3 class="purelane-title">
              <a href="#">
                {% cycle 'Tap cleaner & limescale remover', 'Kitchen cleaner, foaming', 'Copper, bronze & brass cleaner', 'Washing machine cleaner & descaler tablets' %}
              </a>
            </h3>
            <div class="purelane-rate"><b>★ 4.8</b> · 230+ reviews</div>
            <div class="purelane-pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div>
            <button class="purelane-btn purelane-btn-ghost purelane-btn-sm" type="button">Add to cart</button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
