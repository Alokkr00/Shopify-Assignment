{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="combos" data-scene="3">
  <div class="purelane-wrap">

    <div class="purelane-panel-head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      <h2 class="purelane-d2">{{ section.settings.heading | default: 'Best selling combos' }}</h2>

      <div class="purelane-rule">
        <i></i>
        {% render 'purelane-icons', icon: 'leaf-shield' %}
        <i></i>
      </div>

      {%- if section.settings.lede != blank -%}
        <p class="purelane-lede" style="margin: 14px auto 0">
          {{ section.settings.lede }}
        </p>
      {%- endif -%}
    </div>

    <div class="purelane-comborail purelane-rv">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="purelane-glass purelane-combo {% if block.settings.is_featured %}purelane-hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="purelane-tray">
              {%- if block.settings.savings_tag != blank -%}
                <span class="purelane-save">{{ block.settings.savings_tag }}</span>
              {%- endif -%}

              {%- if block.settings.flag_tag != blank -%}
                <span class="purelane-flag">{{ block.settings.flag_tag }}</span>
              {%- endif -%}

              <div class="purelane-stack">
                <span class="purelane-it">
                  {%- if block.settings.item_1_image != blank -%}
                    <img src="{{ block.settings.item_1_image | image_url: width: 140 }}" alt="{{ block.settings.item_1_title | escape }}" class="purelane-pimg" loading="lazy">
                  {%- else -%}
                    {% render 'purelane-icons', icon: 'bottle-fallback' %}
                  {%- endif -%}
                  <span>{{ block.settings.item_1_title | default: 'Cuts grease instantly' }}</span>
                </span>

                {%- if block.settings.item_2_title != blank -%}
                  <span class="purelane-plus" aria-hidden="true">+</span>
                  <span class="purelane-it">
                    {%- if block.settings.item_2_image != blank -%}
                      <img src="{{ block.settings.item_2_image | image_url: width: 140 }}" alt="{{ block.settings.item_2_title | escape }}" class="purelane-pimg" loading="lazy">
                    {%- else -%}
                      {% render 'purelane-icons', icon: 'bottle-fallback' %}
                    {%- endif -%}
                    <span>{{ block.settings.item_2_title }}</span>
                  </span>
                {%- endif -%}

                {%- if block.settings.item_3_title != blank -%}
                  <span class="purelane-plus" aria-hidden="true">+</span>
                  <span class="purelane-it">
                    {%- if block.settings.item_3_image != blank -%}
                      <img src="{{ block.settings.item_3_image | image_url: width: 140 }}" alt="{{ block.settings.item_3_title | escape }}" class="purelane-pimg" loading="lazy">
                    {%- else -%}
                      {% render 'purelane-icons', icon: 'bottle-fallback' %}
                    {%- endif -%}
                    <span>{{ block.settings.item_3_title }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>

            <div class="purelane-body">
              <h3>{{ block.settings.title | default: 'Kitchen essentials' }}</h3>
              <div class="purelane-cnt">{{ block.settings.product_count | default: '3 products' }}</div>
              <p class="purelane-inc">{{ block.settings.inclusions }}</p>

              <div class="purelane-prow">
                <strong>{{ block.settings.price | default: '₹499' }}</strong>
                {%- if block.settings.compare_at_price != blank -%}
                  <s>{{ block.settings.compare_at_price }}</s>
                {%- endif -%}
                {%- if block.settings.savings_badge != blank -%}
                  <em>{{ block.settings.savings_badge }}</em>
                {%- endif -%}
              </div>

              <div class="purelane-fine">{{ block.settings.fine_print | default: 'Inclusive of all taxes · COD available' }}</div>

              <a class="purelane-btn {% if block.settings.is_featured %}purelane-btn-primary{% else %}purelane-btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
                {{ block.settings.button_label | default: 'Shop bundle' }}
                {% render 'purelane-icons', icon: 'arrow-right' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Combos matching purelane prototype -->
        <article class="purelane-glass purelane-combo">
          <div class="purelane-tray">
            <span class="purelane-save">You save ₹398</span>
            <span class="purelane-flag">Most popular</span>
            <div class="purelane-stack">
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Cuts grease instantly</span></span>
              <span class="purelane-plus" aria-hidden="true">+</span>
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Squeaky clean dishes</span></span>
              <span class="purelane-plus" aria-hidden="true">+</span>
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Melts hard water stains</span></span>
            </div>
          </div>
          <div class="purelane-body">
            <h3>Kitchen essentials</h3>
            <div class="purelane-cnt">3 products</div>
            <p class="purelane-inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner. Everything for a sparkling kitchen.</p>
            <div class="purelane-prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
            <div class="purelane-fine">Inclusive of all taxes · COD available</div>
            <a class="purelane-btn purelane-btn-ghost" href="#bundles">Shop bundle {% render 'purelane-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>

        <article class="purelane-glass purelane-combo purelane-hero-combo">
          <div class="purelane-tray">
            <span class="purelane-save">Biggest saving</span>
            <span class="purelane-flag">Best value</span>
            <div class="purelane-stack">
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Cuts grease instantly</span></span>
              <span class="purelane-plus" aria-hidden="true">+</span>
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Kills 99.9% germs</span></span>
              <span class="purelane-plus" aria-hidden="true">+</span>
              <span class="purelane-it">{% render 'purelane-icons', icon: 'bottle-fallback' %}<span>Gentle hydration</span></span>
            </div>
          </div>
          <div class="purelane-body">
            <h3>Complete home bundle</h3>
            <div class="purelane-cnt">5 products</div>
            <p class="purelane-inc">Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner &amp; Handwash. Our biggest saving box.</p>
            <div class="purelane-prow"><strong>₹799</strong><s>₹1,495</s><em>Save ₹696</em></div>
            <div class="purelane-fine">Inclusive of all taxes · COD available</div>
            <a class="purelane-btn purelane-btn-primary" href="#bundles">Shop bundle {% render 'purelane-icons', icon: 'arrow-right' %}</a>
          </div>
        </article>
      {%- endif -%}
    </div>

    <div class="purelane-swipecue" aria-hidden="true">
      {% render 'purelane-icons', icon: 'arrow-right' %}
      <span>{{ section.settings.swipe_cue | default: 'Swipe for more combos' }}</span>
    </div>

    {%- if section.settings.rail_note != blank -%}
      <p class="purelane-railnote">{{ section.settings.rail_note }}</p>
    {%- endif -%}

  </div>
</section>

