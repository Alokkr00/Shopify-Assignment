{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="whybundles" data-scene="4">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-sec-pad purelane-rv">

      <div class="purelane-panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="purelane-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="purelane-d2" style="margin-top: 12px;">{{ section.settings.heading | default: 'Why bundles beat buying single' }}</h2>
      </div>

      <div class="purelane-wb">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="purelane-wb-i" {{ block.shopify_attributes }}>
              <span class="purelane-ci">
                {%- case block.settings.icon -%}
                  {%- when 'discount' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
                {%- endcase -%}
              </span>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.subtitle }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundle Benefits",
  "tag": "section",
  "class": "purelane-bundle-benefits-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Tile",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "discount", "label": "Rupee Discount" },
            { "value": "check", "label": "Flat Price Check" },
            { "value": "star", "label": "Curated Star" },
            { "value": "truck", "label": "Free Shipping Truck" }
          ],
          "default": "discount"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Benefit Description",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundle Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "discount", "title": "Save up to 45%", "subtitle": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "check", "title": "One flat price", "subtitle": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Curated by experts", "subtitle": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping always", "subtitle": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
