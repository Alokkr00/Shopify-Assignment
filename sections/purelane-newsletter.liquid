{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" data-scene="4" id="PurelaneNewsletter-{{ section.id }}">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-signup purelane-rv">

      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      <h2 class="purelane-d2" style="margin-top: 12px;">{{ section.settings.heading | default: 'Get &#8377;100 off your first bundle' }}</h2>

      {%- if section.settings.lede != blank -%}
        <p class="purelane-lede" style="margin: 0 auto;">
          {{ section.settings.lede }}
        </p>
      {%- endif -%}

      {% form 'customer', class: 'purelane-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, purelane_club">
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail-{{ section.id }}"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
          aria-label="{{ 'sections.newsletter.email_label' | t | default: 'Email address' }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >
        <button class="purelane-btn purelane-btn-primary" type="submit">
          {{ section.settings.button_label | default: 'Get my &#8377;100 off' }}
        </button>

        {%- if form.posted_successfully? -%}
          <p class="purelane-body-s" style="color: #4f7d10; width: 100%; margin-top: 12px;">
            {{ 'sections.newsletter.success' | t | default: 'Thank you for joining! Check your inbox for your &#8377;100 coupon.' }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="purelane-body-s" style="color: #c9761d; width: 100%; margin-top: 12px;">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}
      {% endform %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "tag": "section",
  "class": "purelane-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get &#8377;100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede Text",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my &#8377;100 off"
    }
  ],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
