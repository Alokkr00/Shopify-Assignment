{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="range" data-scene="3">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-range purelane-rv">

      <div class="purelane-range-head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="purelane-kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="purelane-d2" style="margin-top: 10px;">{{ section.settings.heading | default: 'Every room, one shelf' }}</h2>
        </div>
        {%- if section.settings.body != blank -%}
          <p class="purelane-body-s" style="max-width: 34ch; margin-bottom: 4px;">
            {{ section.settings.body }}
          </p>
        {%- endif -%}
      </div>

      <div class="purelane-stripwrap">
        <div class="purelane-rangerow">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 220 }}" alt="{{ block.settings.title | escape }}" class="purelane-pimg" loading="lazy">
              {%- else -%}
                {% render 'purelane-icons', icon: 'bottle-fallback' %}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..10) -%}
              {% render 'purelane-icons', icon: 'bottle-fallback' %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <p class="purelane-striphint">{{ section.settings.mobile_hint | default: 'Swipe to see the full shelf' }}</p>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-range-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "text",
      "id": "mobile_hint",
      "label": "Mobile Swipe Hint",
      "default": "Swipe to see the full shelf"
    }
  ],
  "blocks": [
    {
      "type": "range_item",
      "name": "Shelf Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Name",
          "default": "Cleaner Bottle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Bottle Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Full Range",
      "blocks": [
        { "type": "range_item", "settings": { "title": "Floor cleaner" } },
        { "type": "range_item", "settings": { "title": "Tap cleaner" } },
        { "type": "range_item", "settings": { "title": "Kitchen cleaner" } },
        { "type": "range_item", "settings": { "title": "Toilet cleaner" } },
        { "type": "range_item", "settings": { "title": "Laundry detergent" } },
        { "type": "range_item", "settings": { "title": "Dishwash gel" } },
        { "type": "range_item", "settings": { "title": "Brass cleaner" } },
        { "type": "range_item", "settings": { "title": "Washing machine cleaner" } }
      ]
    }
  ]
}
{% endschema %}
