{{ 'purelane-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

<section class="purelane-sec purelane-wrapper" id="ingredients" data-scene="2">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-sec-pad purelane-rv">

      <div class="purelane-panel-head">
        <h2 class="purelane-d2">{{ section.settings.heading | default: 'Sourced from nature' }}</h2>
        <div class="purelane-rule">
          <i></i>
          {% render 'purelane-icons', icon: 'leaf-shield' %}
          <i></i>
        </div>
      </div>

      <div class="purelane-ing">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="purelane-ing-i" {{ block.shopify_attributes }}>
              <div class="purelane-art">
                {%- if block.settings.custom_image != blank -%}
                  <img src="{{ block.settings.custom_image | image_url: width: 140 }}" alt="{{ block.settings.title | escape }}" width="70" height="70" loading="lazy">
                {%- else -%}
                  {%- case block.settings.ingredient_type -%}
                    {%- when 'coconut' -%}
                      <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="50" cy="62" r="25"/>
                        <path d="M31 53c9-6 29-6 38 0" stroke="#f0a03c"/>
                        <path d="M41 63c4 8 14 8 18 0" opacity=".55"/>
                        <path d="M50 37V25"/>
                        <path d="M50 27C42 18 30 16 21 21c5 10 17 13 29 6Z" stroke="#f0a03c"/>
                        <path d="M50 27c8-9 20-11 29-6-5 10-17 13-29 6Z" stroke="#f0a03c"/>
                      </svg>
                    {%- when 'orange' -%}
                      <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="45" cy="58" r="23"/>
                        <path d="M45 35v46M22 58h46" opacity=".4"/>
                        <path d="M29 42 61 74M61 42 29 74" opacity=".26"/>
                        <path d="M62 28c13-1 20 10 15 20-4 8-15 9-19 2" stroke="#f0a03c"/>
                        <path d="M45 34c-3-8 2-15 10-16 1 9-3 15-10 16Z" stroke="#f0a03c"/>
                      </svg>
                    {%- when 'soapnut' -%}
                      <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="36" cy="66" r="16"/>
                        <circle cx="64" cy="69" r="14"/>
                        <circle cx="50" cy="43" r="14"/>
                        <path d="M50 29V17"/>
                        <path d="M50 21c-8-8-18-8-23-2 7 8 17 10 23 2Z" stroke="#f0a03c"/>
                        <path d="M31 60a5 5 0 0 1 4-4" opacity=".6"/>
                        <path d="M46 38a5 5 0 0 1 4-4" opacity=".6"/>
                      </svg>
                    {%- when 'neem' -%}
                      <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 82C36 66 58 44 82 20" stroke="#f0a03c"/>
                        <path d="M27 73c-6-7-4-15 3-18 4 7 3 14-3 18Z"/>
                        <path d="M31 69c8-4 15 0 16 8-8 2-14-1-16-8Z"/>
                        <path d="M41 59c-6-7-4-16 3-19 4 7 3 15-3 19Z"/>
                        <path d="M45 55c9-4 16 0 17 8-8 2-15-1-17-8Z"/>
                        <path d="M56 44c-6-7-4-16 3-19 4 7 3 15-3 19Z"/>
                        <path d="M60 40c9-4 16 0 17 8-8 2-15-1-17-8Z"/>
                        <path d="M70 30c-5-7-3-15 4-18 3 7 2 14-4 18Z"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 100 100" fill="none">
                        <g fill="#ece6f7" opacity=".88">
                          <path d="M50 88C44 62 39 42 24 15c15 27 22 47 29 73Z"/>
                          <path d="M52 88C50 60 50 39 44 9c11 29 13 50 12 79Z"/>
                          <path d="M54 88C56 60 60 40 74 13c-11 28-15 48-16 75Z"/>
                          <path d="M56 88C60 64 68 48 86 27c-14 22-21 38-26 61Z"/>
                          <path d="M48 88C44 66 36 50 18 30c14 21 22 36 27 58Z"/>
                        </g>
                        <path d="M50 88h6" stroke="#f0a03c" stroke-width="2.4" stroke-linecap="round"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.subtitle }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Ingredients",
  "tag": "section",
  "class": "purelane-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Botanical Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "ingredient_type",
          "label": "Botanical Vector Art",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange", "label": "Orange Peel" },
            { "value": "soapnut", "label": "Soap Nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Overrides vector)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient Name",
          "default": "Coconut"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Benefit Subtitle",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "ingredient_type": "coconut", "title": "Coconut", "subtitle": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "ingredient_type": "orange", "title": "Orange peel", "subtitle": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "ingredient_type": "soapnut", "title": "Soap nut", "subtitle": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "ingredient_type": "neem", "title": "Neem", "subtitle": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "ingredient_type": "lemongrass", "title": "Lemongrass", "subtitle": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
